<div id="landingContainer" style="display: none;">
<div class="hm-app"><div class="hero">
<div class="scenes" aria-hidden="true">
<figure class="scene"><img src="assets/images/interface/<%= launcherBackground %>" alt=""></figure>
</div>
<header class="top">
<a class="brand" id="image_seal_container" href="#" aria-label="Honor & Magic, accueil"><img src="assets/images/interface/honor-magic.webp" alt="" width="44" height="58"><span>HONOR <i>&</i> MAGIC<small>UN UNIVERS À ÉCRIRE</small></span></a>
<div class="titlebar-drag" aria-hidden="true"></div>
<div class="shortcuts">
<a class="shortcut" href="<%= lang('landing.mediaDiscordURL') %>" rel="noopener noreferrer" aria-label="Rejoindre Discord (nouvel onglet)"><img src="assets/images/interface/discord.svg" alt=""></a>
<button type="button" class="shortcut settings-trigger" id="settingsMediaButton" aria-expanded="false" aria-controls="settingsContainer" aria-label="Paramètres" title="Paramètres"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 3-.5 2.6L7.6 6.7 5 5.9l-2 3.5 2 1.8v2L3 15l2 3.5 2.6-.8 1.9 1.1.5 2.2h4l.5-2.2 1.9-1.1 2.6.8 2-3.5-2-1.8v-2l2-1.8-2-3.5-2.6.8-1.9-1.1L14 3z"/><circle cx="12" cy="12" r="3"/></svg></button>
<button type="button" class="shortcut shirt" aria-expanded="false" aria-controls="garde-robe" aria-label="Garde-robe" title="Garde-robe"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 3-5 3-2 4 4 2 2-3v12h10V9l2 3 4-2-2-4-5-3a4 4 0 0 1-8 0Z"/></svg></button>
</div>
</header>
<section class="fitting" aria-label="Aperçu du skin sur l’accueil">
<div class="model"><canvas class="skin" width="218" height="320" role="img" tabindex="0" aria-label="Skin Minecraft en 3D"></canvas><div class="skin-name" aria-live="polite"></div></div>
</section>
<%- include('wardrobe') %>

</div>
<footer class="dock">
    <progress id="launch_progress" value="0" max="100" aria-label="Progression du lancement" hidden></progress>
    <div class="online" id="hm-server" role="status"><i class="dot" aria-hidden="true"></i><span>Statut du serveur…</span></div>
    <div class="launch launch-home">
        <div id="launch_content"><button id="launch_button" type="button" class="play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4 20 12 6 20z"/></svg><b>Jouer</b></button></div>
        <span id="launch_details" class="launch-announcement" role="status"></span>
        <div class="players" id="server_status_wrapper"><span id="player_count"></span></div>
    </div>
    <div class="launch launch-wardrobe"><button type="button" class="play wardrobe-done"><b>Terminé</b></button></div>
    <div class="version">Launcher v<%= launcherVersion %></div>
</footer>
</div>
    <div id="newsContainer" inert>
        <button type="button" id="hm-news-close">Retour</button>
        <div id="newsContent" article="-1" style="display: none;">
            <div id="newsStatusContainer">
                <div id="newsStatusContent">
                    <div id="newsTitleContainer">
                        <a id="newsArticleTitle" href="#">Lorem Ipsum</a>
                    </div>
                    <div id="newsMetaContainer">
                        <div id="newsArticleDateWrapper">
                            <span id="newsArticleDate">Mar 15, 44 BC, 9:14 AM</span>
                        </div>
                        <div id="newsArticleAuthorWrapper">
                            <span id="newsArticleAuthor">by Cicero</span>
                        </div>
                        <a href="#" id="newsArticleComments">0 Comments</a>
                    </div>
                </div>
                <div id="newsNavigationContainer">
                    <button id="newsNavigateLeft">
                        <svg id="newsNavigationLeftSVG" viewBox="0 0 24.87 13.97">
                            <defs>
                                <style>.arrowLine{fill:none;stroke:#FFF;stroke-width:2px;transition: 0.25s ease;}</style>
                            </defs>
                            <polyline class="arrowLine" points="0.71 13.26 12.56 1.41 24.16 13.02"/>
                        </svg>
                    </button>
                    <span id="newsNavigationStatus"><%- lang('landing.newsNavigationStatus', { currentPage: 1, totalPages: 1 }) %></span>
                    <button id="newsNavigateRight">
                        <svg id="newsNavigationRightSVG" viewBox="0 0 24.87 13.97">
                            <defs>
                                <style>.arrowLine{fill:none;stroke:#FFF;stroke-width:2px;transition: 0.25s ease;}</style>
                            </defs>
                            <polyline class="arrowLine" points="0.71 13.26 12.56 1.41 24.16 13.02"/>
                        </svg>
                    </button>
                </div>
            </div>
            <div id="newsArticleContainer">
                <div id="newsArticleContent">
                    <div id="newsArticleContentScrollable">
                        <!-- Article Content -->
                    </div>
                </div>
            </div>
        </div>
        <div id="newsErrorContainer">
            <div id="newsErrorLoading">
                <span id="nELoadSpan" class="newsErrorContent"><%- lang('landing.newsErrorLoadSpan') %></span>
            </div>
            <div id="newsErrorFailed" style="display: none;">
                <span id="nEFailedSpan" class="newsErrorContent"><%- lang('landing.newsErrorFailedSpan') %></span>
                <button id="newsErrorRetry"><%- lang('landing.newsErrorRetryButton') %></button>
            </div>
            <div id="newsErrorNone" style="display: none;">
                <span id="nENoneSpan" class="newsErrorContent"><%- lang('landing.newsErrorNoneSpan') %></span>
            </div>
        </div>
    </div>
    <button id="newsButton" type="button" aria-label="Actualités" title="Actualités"><span aria-hidden="true">✧</span><span id="newsButtonAlert" hidden></span></button>
    <script src="./assets/js/scripts/landing.js"></script>
    <script src="./assets/js/scripts/wardrobe.js"></script>
</div>
