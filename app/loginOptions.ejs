<div id="loginOptionsContainer" class="hm-auth-view" style="display: none;">
    <section class="hm-auth-card" aria-labelledby="loginOptionsTitle">
        <h2 id="loginOptionsTitle"><%= lang('loginOptions.loginOptionsTitle') %></h2>
        <p class="hm-auth-description"><%= lang('loginOptions.description') %></p>
        <button id="loginOptionMicrosoft" type="button">
            <img src="assets/images/icons/microsoft.svg" alt="">
            <span><%= lang('loginOptions.loginWithMicrosoft') %></span>
        </button>
        <p class="hm-auth-hint">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 4v3"/></svg>
            <span><%= lang('loginOptions.hint') %></span>
        </p>
        <div id="loginOptionCancelContainer" style="display: none;">
            <button id="loginOptionCancelButton" type="button"><%= lang('loginOptions.cancelButton') %></button>
        </div>
    </section>
    <script src="./assets/js/scripts/loginOptions.js"></script>
</div>
